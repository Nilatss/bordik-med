# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which is committed deliberately so contributors
# know which keys are required.
!.env.local.example

# vercel
.vercel

# sentry — build plugin auth token (covered by .env* but listed explicitly)
.env.sentry-build-plugin
.sentryclirc

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev artifacts
/tmp-pdf/

# Claude Code: проектные команды и settings шарим с командой,
# остальное (плагины, локальные планы, кеш) — игнорируем.
/.claude/*
!/.claude/commands/
!/.claude/settings.json
!/.claude/launch.json

# Obsidian vault config — создаётся если открыть проект как vault.
# Не нужен в репо (vault лежит в ~/vault/bordik-med/).
/.obsidian/

# Serwist / PWA generated artefacts (rebuilt on every `next build`)
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js
/public/swe-worker-*.js.map
/public/workbox-*.js
/public/workbox-*.js.map

# Content build pipeline output (regenerated from lib/tools-catalog.ts +
# lib/tool-meta-data.ts on every prebuild via scripts/build-content.mjs).
# Keeping these in repo creates noisy diffs and merge conflicts; CI rebuilds
# them anyway.
/data/catalog.meta.json
/data/manifest.json
/data/tools/
/public/catalog.meta.json
/public/content-manifest.json
/public/search-*.json
/public/tools-data/
/public/snapshot.json
/data/snapshot.json

# MediaPipe WASM is regenerated from node_modules by
# scripts/sync-mediapipe.mjs on every prebuild. Don't commit the
# 34 MB of binaries — they live in node_modules already.
/public/mediapipe/

# Curriculum stats are pre-computed from lib/curriculum.ts at every
# prebuild by scripts/build-curriculum-stats.mjs. Generated artifact;
# committing it would create noisy diffs and merge conflicts.
/lib/curriculum-stats.ts

.vercel

# Graphify (claude-code-memory-setup) — AST-кэш. Только cache/ исключаем
# (локальный бинарь). graph.json и GRAPH_REPORT.md можно коммитить —
# они полезны команде для агрегированных запросов о структуре кода.
graphify-out/cache/
