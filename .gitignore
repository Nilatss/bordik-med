# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev artifacts
/tmp-pdf/
/.claude/

# Serwist / PWA generated artefacts (rebuilt on every `next build`)
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js
/public/swe-worker-*.js.map
/public/workbox-*.js
/public/workbox-*.js.map

# Content build pipeline output (regenerated from lib/tools-catalog.ts +
# lib/tool-meta-data.ts on every prebuild via scripts/build-content.mjs).
# Keeping these in repo creates noisy diffs and merge conflicts; CI rebuilds
# them anyway.
/data/catalog.meta.json
/data/manifest.json
/data/tools/
/public/catalog.meta.json
/public/content-manifest.json
/public/search-*.json
/public/tools-data/
/public/snapshot.json
/data/snapshot.json

.vercel
