# Bordik Med backend env vars
# Copy this file to `.env.local` (git-ignored) and fill in real values.
# See docs/BACKEND.md for where to obtain these.

# ── Supabase (auth + database) ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_or_eyJhbGc..._key_here

# ── Server-side only (NEVER expose to client) ────────────────────
# Required for /api/account/delete and admin endpoints
SUPABASE_SERVICE_ROLE_KEY=sb_secret_..._key_here
GEMINI_API_KEY=your_gemini_api_key_from_aistudio

# ── App URL (used for OG images, email redirects, etc.) ──────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Upstash Redis (rate limiting; falls back to in-memory if unset) ──
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# ── Sentry (error tracking; safe to leave unset in dev) ──────────
# DSN is exposed to the client by design — it's a write-only ingest key.
NEXT_PUBLIC_SENTRY_DSN=https://...@oXXXXX.ingest.sentry.io/XXXXX
# Auth token only needed for source-map upload at build time (Vercel CI).
# Don't paste it here for local dev — leave blank.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=bordik-med
SENTRY_PROJECT=javascript-nextjs

# Force Sentry on in dev (otherwise it's only enabled in production)
# SENTRY_FORCE_ENABLE=1
# NEXT_PUBLIC_SENTRY_FORCE_ENABLE=1
