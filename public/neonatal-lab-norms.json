{"version":"1.1.0","lastUpdated":"2026-05-09","source":"Gomella's Neonatology 8th ed. + AAP / Avery's Diseases of the Newborn 11th ed. + КР МЗ РФ","license":"Reference values combined from standard neonatology references","groups":[{"id":"blood_gas","title_ru":"Газы крови (артериальные)","title_en":"Arterial blood gas","values":[{"name_ru":"pH","name_en":"pH","term":"7.30-7.45","preterm":"7.25-7.40","unit":"—","notes":"Капиллярная кровь — допустимый сдвиг pH ниже на 0.05; PaCO₂ выше на ~5 мм рт ст"},{"name_ru":"PaO₂","name_en":"PaO₂","term":"60-80","preterm":"50-80","unit":"мм рт ст","notes":"Аккуратно интерпретировать капиллярные значения"},{"name_ru":"PaCO₂","name_en":"PaCO₂","term":"35-45","preterm":"35-45 (permissive 45-55)","unit":"мм рт ст","notes":"Permissive hypercapnia (pH ≥ 7.25) — стратегия для VLBW"},{"name_ru":"HCO₃⁻","name_en":"Bicarbonate","term":"18-24","preterm":"16-22","unit":"ммоль/л","notes":"Compensatory metabolic response"},{"name_ru":"BE / SBE","name_en":"Base excess","term":"±5","preterm":"±5","unit":"ммоль/л","notes":"Cord BE ≤ -12 — критерий асфиксии (P21 МКБ-10)"},{"name_ru":"Anion gap","name_en":"Anion gap","term":"8-16","preterm":"8-16","unit":"ммоль/л","notes":"Na − (Cl + HCO₃); high AG → lactate/ketones/IEM"},{"name_ru":"SpO₂ target preterm","name_en":"SpO₂ target preterm","term":"90-95 %","preterm":"90-95 %","unit":"%","notes":"NeOProM 2018: 91-95 % vs 85-89 % — higher target снижает mortality + NEC"}]},{"id":"electrolytes","title_ru":"Электролиты","title_en":"Electrolytes","values":[{"name_ru":"Натрий (Na)","name_en":"Sodium","term":"135-145","preterm":"133-145 (early days), 135-145 (after)","unit":"ммоль/л","notes":"Hyponatremia — late onset у preterm с TPN; Na restriction первые 4-7 d"},{"name_ru":"Калий (K)","name_en":"Potassium","term":"3.5-5.5","preterm":"3.5-6.0 (early), 3.5-5.5 (after)","unit":"ммоль/л","notes":"NOHK (non-oliguric hyperkalemia) у extremely preterm < 24-48 h"},{"name_ru":"Хлор (Cl)","name_en":"Chloride","term":"97-107","preterm":"97-110","unit":"ммоль/л","notes":"Hypochloremic alkalosis при diuretics"},{"name_ru":"Кальций общий","name_en":"Total calcium","term":"2.0-2.6","preterm":"1.75-2.6","unit":"ммоль/л","notes":"1 мг/дл = 0.25 ммоль/л; ionized — better marker"},{"name_ru":"Кальций ионизированный","name_en":"Ionized calcium","term":"1.0-1.4","preterm":"0.9-1.4","unit":"ммоль/л","notes":"Гипокальциемия: term < 1.0; preterm < 0.9; severe < 0.8 + sympt"},{"name_ru":"Магний (Mg)","name_en":"Magnesium","term":"0.7-1.0","preterm":"0.7-1.0","unit":"ммоль/л","notes":"Hypomagnesemia < 0.66 ммоль/л; severe < 0.5"},{"name_ru":"Фосфор (PO₄)","name_en":"Phosphate","term":"1.4-2.7","preterm":"1.6-3.1","unit":"ммоль/л","notes":"Гипофосфатемия в osteopenia of prematurity"}]},{"id":"glucose_metabolic","title_ru":"Глюкоза и метаболиты","title_en":"Glucose & metabolites","values":[{"name_ru":"Глюкоза (term, > 24 ч)","name_en":"Glucose (term, > 24 ч)","term":"≥ 2.6 ммоль/л (≥ 47 мг/дл)","preterm":"≥ 2.6 ммоль/л","unit":"ммоль/л","notes":"PES 2015 thresholds: < 1.8 first 4 h; < 2.0 4-24 h; < 2.6 > 24 h; target > 4.0 после 48 h"},{"name_ru":"Лактат","name_en":"Lactate","term":"< 2.5","preterm":"< 3.0","unit":"ммоль/л","notes":"↑ При asphyxia, sepsis, IEM, shock"},{"name_ru":"Аммиак","name_en":"Ammonia","term":"< 110","preterm":"< 150","unit":"мкмоль/л","notes":"↑ В urea cycle defects, organic acidemias, liver failure"},{"name_ru":"Креатинин (term, > 7 d)","name_en":"Creatinine (term, > 7 d)","term":"20-50","preterm":"30-100 (decreasing)","unit":"мкмоль/л","notes":"Высокий первые дни от maternal Cr; снижается в течение 2-3 нед"},{"name_ru":"Урея (BUN)","name_en":"Urea","term":"1.4-7.1","preterm":"1.4-7.1","unit":"ммоль/л","notes":"1 мг/дл = 0.357 ммоль/л; ↑ при dehydration, acute kidney injury"}]},{"id":"bilirubin","title_ru":"Билирубин","title_en":"Bilirubin","values":[{"name_ru":"Total bilirubin (cord)","name_en":"Total bilirubin (cord)","term":"< 35 мкмоль/л (< 2 мг/дл)","preterm":"< 35 мкмоль/л","unit":"мкмоль/л","notes":"1 мг/дл = 17.1 мкмоль/л"},{"name_ru":"Total bilirubin (Day 3-5 peak)","name_en":"Total bilirubin (Day 3-5)","term":"< 200 мкмоль/л (< 12 мг/дл)","preterm":"< 170 мкмоль/л","unit":"мкмоль/л","notes":"Phototherapy threshold AAP 2022 / NICE CG98 / КР РФ ГБН — см. neo-bili-2022 calc"},{"name_ru":"Conjugated bilirubin","name_en":"Conjugated bilirubin","term":"< 17 мкмоль/л (< 1 мг/дл)","preterm":"< 17 мкмоль/л","unit":"мкмоль/л","notes":"> 1 мг/дл (если total ≤ 5) или > 20 % total — cholestasis (NASPGHAN 2017)"},{"name_ru":"Альбумин","name_en":"Albumin","term":"30-40 г/л","preterm":"20-35 г/л","unit":"г/л","notes":"B/A ratio ≥ 8 у term (≥ 7 у late preterm) — DVET indication"}]},{"id":"cbc_term","title_ru":"CBC term newborn","title_en":"CBC term newborn","values":[{"name_ru":"Hemoglobin (Day 1)","name_en":"Hemoglobin Day 1","term":"150-220 г/л","preterm":"140-200 г/л","unit":"г/л","notes":"Wide range; cord blood lower than capillary"},{"name_ru":"Hemoglobin (Day 30)","name_en":"Hemoglobin Day 30","term":"120-180 г/л","preterm":"100-150 г/л (physiologic nadir)","unit":"г/л","notes":"Anemia of prematurity nadir 4-6 нед age"},{"name_ru":"Hematocrit (Day 1)","name_en":"Hematocrit Day 1","term":"0.50-0.65","preterm":"0.45-0.60","unit":"—","notes":"Polycythemia ≥ 0.65 — partial exchange threshold"},{"name_ru":"Reticulocytes (Day 1)","name_en":"Reticulocytes Day 1","term":"3-7 %","preterm":"5-10 %","unit":"%","notes":"Падают через 3-5 дней до < 1 % term"},{"name_ru":"WBC","name_en":"WBC","term":"9-30 × 10⁹/л (Day 1)","preterm":"5-25 × 10⁹/л","unit":"× 10⁹/л","notes":"Leukocytosis normal; sepsis: bands > 20 % или I/T ratio > 0.2"},{"name_ru":"Platelets","name_en":"Platelets","term":"150-450 × 10⁹/л","preterm":"150-450 × 10⁹/л","unit":"× 10⁹/л","notes":"Thrombocytopenia: < 150 mild, < 50 severe (transfusion threshold с bleeding)"},{"name_ru":"MCV","name_en":"MCV","term":"100-110 fL","preterm":"108-118 fL","unit":"fL","notes":"Macrocytic у newborn"}]},{"id":"coagulation","title_ru":"Коагуляция","title_en":"Coagulation","values":[{"name_ru":"PT","name_en":"PT","term":"13-21 sec","preterm":"14-24 sec","unit":"sec","notes":"Prolonged у preterm (low vit K-dependent factors)"},{"name_ru":"PTT (aPTT)","name_en":"aPTT","term":"30-60 sec","preterm":"35-80 sec","unit":"sec","notes":"Higher variability у preterm"},{"name_ru":"INR","name_en":"INR","term":"1.0-1.6","preterm":"1.0-2.0","unit":"—","notes":"VKDB if INR > 4 + bleeding (give vit K)"},{"name_ru":"Fibrinogen","name_en":"Fibrinogen","term":"1.5-3.0 г/л","preterm":"1.5-3.0 г/л","unit":"г/л","notes":"DIC: ↓ fibrinogen + ↑ D-dimer + thrombocytopenia"},{"name_ru":"D-dimer","name_en":"D-dimer","term":"< 0.5 мг/л","preterm":"Higher baseline 0.7-1.5","unit":"мг/л","notes":"Limited utility в neonates due to physiologic elevation"}]},{"id":"csf","title_ru":"CSF (ликвор)","title_en":"CSF (lumbar puncture)","values":[{"name_ru":"WBC","name_en":"WBC","term":"0-22 cells/мкл (90 % < 25)","preterm":"0-29 cells/мкл","unit":"cells/мкл","notes":"Higher у preterm; Bacterial meningitis: usually > 200 PMN-predominant"},{"name_ru":"Protein","name_en":"Protein","term":"0.2-1.5 г/л","preterm":"0.65-1.5 г/л (> 32 нед); 0.65-2.4 (< 32 нед)","unit":"г/л","notes":"Higher у preterm; meningitis: > 2 г/л"},{"name_ru":"Glucose","name_en":"Glucose","term":"1.5-4.4 ммоль/л (≥ 2/3 serum)","preterm":"1.4-3.9 ммоль/л (≥ 1/2 serum)","unit":"ммоль/л","notes":"↓ В bacterial meningitis; CSF/serum ratio < 0.4 suggests bacterial"},{"name_ru":"RBC","name_en":"RBC","term":"0-50 cells/мкл (traumatic)","preterm":"0-100 cells/мкл","unit":"cells/мкл","notes":"Traumatic tap может confound interpretation; correction: subtract 1 WBC per 500 RBC"}]},{"id":"renal_urine","title_ru":"Моча и почки","title_en":"Urine & renal","values":[{"name_ru":"Urine output","name_en":"Urine output","term":"≥ 1-3 мл/кг/ч","preterm":"≥ 1-3 мл/кг/ч","unit":"мл/кг/ч","notes":"< 1 — oliguria (acute kidney injury); 0 — anuria"},{"name_ru":"FENa","name_en":"FENa","term":"< 1 %","preterm":"< 3 %","unit":"%","notes":"Higher у preterm (immature tubules); > 3 % у term — intrinsic AKI vs prerenal"},{"name_ru":"Specific gravity","name_en":"Specific gravity","term":"1.005-1.020","preterm":"1.005-1.015","unit":"—","notes":"Concentrating ability limited у preterm"},{"name_ru":"Urine Ca:Cr ratio","name_en":"Urine Ca:Cr ratio","term":"< 0.86 ммоль/ммоль","preterm":"< 1.0 ммоль/ммоль","unit":"ммоль/ммоль","notes":"Nephrocalcinosis screen у chronic furosemide"}]},{"id":"liver_function","title_ru":"Печёночные пробы","title_en":"Liver function","values":[{"name_ru":"AST (SGOT)","name_en":"AST","term":"20-65 ед/л","preterm":"20-65 ед/л","unit":"ед/л","notes":"Elevated в asphyxia, sepsis, IEM"},{"name_ru":"ALT (SGPT)","name_en":"ALT","term":"5-25 ед/л","preterm":"5-30 ед/л","unit":"ед/л","notes":"Liver-specific; ↑ в hepatitis, cholestasis"},{"name_ru":"GGT","name_en":"GGT","term":"30-200 ед/л","preterm":"30-280 ед/л","unit":"ед/л","notes":"↑ В biliary atresia, cholestasis"},{"name_ru":"Alkaline phosphatase","name_en":"Alkaline phosphatase","term":"150-420 ед/л","preterm":"200-500 ед/л","unit":"ед/л","notes":"Higher baseline в neonates; ↑ rickets, BPD"}]},{"id":"thyroid_endocrine","title_ru":"Щитовидная железа и эндокрин","title_en":"Thyroid & endocrine","values":[{"name_ru":"TSH (Day 1-3)","name_en":"TSH Day 1-3","term":"1-39 мЕд/л (peak Day 1)","preterm":"1-30 мЕд/л","unit":"мЕд/л","notes":"Newborn screen TSH > 50 — likely CH; < 20 normal; 20-50 repeat"},{"name_ru":"Free T4","name_en":"Free T4","term":"20-50 пмоль/л","preterm":"10-40 пмоль/л","unit":"пмоль/л","notes":"Goal CH treatment: upper half normal (20-30 пмоль/л = 1.4-2.3 нг/дл)"},{"name_ru":"Cortisol","name_en":"Cortisol","term":"70-700 нмоль/л (variable)","preterm":"70-700 нмоль/л","unit":"нмоль/л","notes":"Adrenal insufficiency: random < 70 + clinical signs"},{"name_ru":"17-OH progesterone (CAH screen)","name_en":"17-OH progesterone (CAH screen)","term":"< 30 нмоль/л","preterm":"< 60 нмоль/л","unit":"нмоль/л","notes":"↑ В congenital adrenal hyperplasia (newborn screening)"},{"name_ru":"25-OH-Vitamin D","name_en":"25-OH-Vitamin D","term":"> 75 нмоль/л (> 30 нг/мл)","preterm":"> 75 нмоль/л","unit":"нмоль/л","notes":"Sufficient > 30 нг/мл; deficient < 20 нг/мл; severe < 10 нг/мл"}]},{"id":"cranial_us","title_ru":"УЗИ головного мозга (cranial US)","title_en":"Cranial Ultrasound","values":[{"name_ru":"Передний рог бокового желудочка (anterior horn width)","name_en":"Anterior horn width (AHW)","term":"< 3 мм","preterm":"< 4 мм","unit":"мм","notes":"AHW > 6 мм — risk PHVD (Brouwer 2010); ELVIS triggers > 6 мм + AVI > 97th"},{"name_ru":"Ventricular index (VI) (Levene)","name_en":"Ventricular Index (Levene)","term":"8-14 мм","preterm":"8-14 мм","unit":"мм","notes":"Levene 1981; > 4 мм above 97th percentile = ventriculomegaly"},{"name_ru":"Толщина коры головного мозга","name_en":"Cortical thickness","term":"2-4 мм","preterm":"1.5-3.5 мм","unit":"мм","notes":"Зависит от GA + PMA"},{"name_ru":"Большая цистерна (cisterna magna)","name_en":"Cisterna magna","term":"< 8 мм","preterm":"< 8 мм","unit":"мм","notes":"> 10 мм — Dandy-Walker spectrum"},{"name_ru":"Pulsatility index ACA (Doppler)","name_en":"ACA pulsatility index (Doppler)","term":"0.6-0.8","preterm":"0.55-0.85","unit":"—","notes":"↓ PI < 0.55 — vasodilation (HIE, sepsis); ↑ PI > 0.9 — high resistance / IVH risk"},{"name_ru":"Resistive index ACA","name_en":"ACA resistive index","term":"0.65-0.75","preterm":"0.65-0.85","unit":"—","notes":"RI < 0.55 после asphyxia — predictive HIE poor outcome (Archer 1986)"},{"name_ru":"Subependymal cyst (если присутствуют)","name_en":"Subependymal cyst","term":"< 3 мм диаметр","preterm":"Variable — обычно benign","unit":"мм","notes":"Обычно benign; > 3 мм или persistent — TORCH workup"}]},{"id":"chest_xray","title_ru":"Rentgen грудной клетки (CXR)","title_en":"Chest X-ray","values":[{"name_ru":"ETT кончик positioning","name_en":"ETT tip position","term":"T1-T2 (above carina ~ 1-2 cm)","preterm":"T1-T2","unit":"уровень позвонка","notes":"Carina T3-T4. ETT внутрь R main bronchus → atelectasis; чрезмерно высоко → exta tubation risk"},{"name_ru":"UVC (umbilical venous catheter)","name_en":"UVC tip position","term":"T9-T10 (above diaphragm IVC/RA junction)","preterm":"T9-T10","unit":"уровень позвонка","notes":"Above diaphragm preferred; в liver — risk hepatic necrosis при гиперосмолярных fluids"},{"name_ru":"UAC (umbilical arterial catheter)","name_en":"UAC tip position","term":"High: T6-T9 ИЛИ Low: L3-L4","preterm":"High: T6-T9","unit":"уровень позвонка","notes":"High preferred (Cochrane 2010); avoid T11-L2 (renal/celiac arteries)"},{"name_ru":"Cardiothoracic ratio","name_en":"Cardiothoracic ratio","term":"0.55-0.60","preterm":"0.55-0.65","unit":"—","notes":"Преtermin slightly higher; > 0.65 — cardiomegaly (PDA HSPDA, CHD)"},{"name_ru":"Lung volume (по T8 expansion)","name_en":"Lung volume","term":"9-10 ribs anterior","preterm":"8-9 ribs","unit":"ребра","notes":"Hyperexpansion (> 10) — air trapping (MAS, PIE); hypoexpansion — RDS, atelectasis"},{"name_ru":"RDS findings","name_en":"RDS X-ray findings","term":"—","preterm":"Reticulogranular pattern, air bronchograms, белая лёгкая","unit":"качественно","notes":"4 степени I-IV (см. neo-rds-class)"},{"name_ru":"MAS findings","name_en":"MAS X-ray findings","term":"Coarse irregular opacities + hyperinflation","preterm":"—","unit":"качественно","notes":"MAS у post-term / late preterm; ball-valve effect → air leak"},{"name_ru":"Pneumothorax","name_en":"Pneumothorax","term":"Loss vascular markings; lung edge","preterm":"Same","unit":"качественно","notes":"Tension PT — mediastinal shift contralateral; transillumination + → confirm"}]},{"id":"echocardiography","title_ru":"Эхокардиография (ECHO) — нормы neonatal","title_en":"Echocardiography — Neonatal Norms","values":[{"name_ru":"LV ejection fraction (LVEF)","name_en":"LV ejection fraction","term":"60-75 %","preterm":"55-75 %","unit":"%","notes":"< 50 % — LV dysfunction (HIE, sepsis, septic cardiomyopathy)"},{"name_ru":"TAPSE (tricuspid annular plane systolic excursion)","name_en":"TAPSE","term":"8-12 мм (зависит от GA)","preterm":"5-9 мм","unit":"мм","notes":"Маркер RV function; TAPSE < age-adjusted 5th percentile = RV dysfunction"},{"name_ru":"PA pressure (estimated по TR jet)","name_en":"PA pressure (TR jet)","term":"< 35 мм рт ст после 24 ч","preterm":"< 35 мм рт ст","unit":"мм рт ст","notes":"PPHN: > 35 mmHg или > 2/3 systemic"},{"name_ru":"PDA diameter (день 1-3)","name_en":"PDA diameter","term":"< 1.5 мм","preterm":"Variable; > 1.5 мм - HSPDA risk","unit":"мм","notes":"HSPDA: > 1.4 mm/kg + LA:Ao > 1.5 + reverse diastolic flow в descending aorta"},{"name_ru":"LA:Ao ratio","name_en":"LA:Ao ratio","term":"< 1.5","preterm":"< 1.5","unit":"—","notes":"> 1.5 — significant L-to-R shunt (HSPDA, VSD)"},{"name_ru":"Foramen ovale flow","name_en":"PFO flow","term":"Left-to-right (normal первые недели)","preterm":"Same","unit":"качественно","notes":"Bidirectional или R-to-L shunt — PPHN evidence"},{"name_ru":"Aortic root diameter","name_en":"Aortic root diameter","term":"8-12 мм (term)","preterm":"5-10 мм","unit":"мм","notes":"Z-score < -2 — aortic stenosis или hypoplasia"},{"name_ru":"Mitral valve E:A ratio","name_en":"Mitral E:A ratio","term":"< 1.0 первые дни (reverses к 1+)","preterm":"Similar pattern","unit":"—","notes":"Diastolic function maturation"}]},{"id":"abdominal_us","title_ru":"УЗИ брюшной полости","title_en":"Abdominal Ultrasound","values":[{"name_ru":"Печень — длина (правая доля)","name_en":"Liver length (right lobe)","term":"5.0-7.5 см","preterm":"4.0-6.0 см","unit":"см","notes":"Hepatomegaly: > 8 см term; Etiology: TORCH, IEM, hemolysis, CHD, sepsis"},{"name_ru":"Селезёнка — длина","name_en":"Spleen length","term":"3.0-4.5 см","preterm":"2.5-3.5 см","unit":"см","notes":"Splenomegaly: > 5 см term; TORCH, hemolysis, sepsis"},{"name_ru":"Почки — длина (right + left)","name_en":"Kidney length","term":"4.0-5.0 см","preterm":"2.5-4.0 см (зависит от GA)","unit":"см","notes":"Cattaneo-D'Antonio nomograms по GA + PMA"},{"name_ru":"Pelvic dilation (anterior-posterior)","name_en":"Renal pelvis AP diameter","term":"< 4 мм (1-й day) / < 7 мм (постнатально)","preterm":"Same","unit":"мм","notes":"> 7 мм после 48 ч — hydronephrosis SFU grading 1-4"},{"name_ru":"Bowel wall thickness","name_en":"Bowel wall thickness","term":"< 2.5 мм","preterm":"< 2.5 мм","unit":"мм","notes":"> 3 мм — NEC; portal venous gas — severe NEC sign"},{"name_ru":"Гематокрит для partial exchange (polycythemia)","name_en":"HCT polycythemia threshold","term":"Symptomatic HCT > 65 % venous","preterm":"Same","unit":"%","notes":"Capillary HCT > 70 % — confirm с venous; partial exchange при > 65 % + симптомах"}]},{"id":"neuro_imaging_mri","title_ru":"MRI головного мозга — postnatal nomograms","title_en":"Brain MRI — Postnatal Norms","values":[{"name_ru":"Brain weight (estimated)","name_en":"Brain weight","term":"350-400 г","preterm":"200-300 г (по GA)","unit":"г","notes":"Birth: 25 % adult brain weight; achieved adult weight ~6 yr"},{"name_ru":"Cortical gyration / sulcation","name_en":"Cortical gyration","term":"Полностью развита tertiary gyrus","preterm":"Variable — primary at 24-26 нед, secondary 28-32 нед, tertiary > 36 нед","unit":"качественно","notes":"Smoothness > expected GA — lissencephaly, pachygyria"},{"name_ru":"Myelination (T2 hypointensity)","name_en":"Myelination (T2 dark)","term":"PLIC + corona radiata visible","preterm":"Очень limited preterm","unit":"качественно","notes":"PLIC absence — predictive of motor impairment in HIE (Rutherford 2010)"},{"name_ru":"Basal ganglia / thalami T1/T2","name_en":"Basal ganglia/thalami signal","term":"Symmetric isointense к gray matter","preterm":"Same","unit":"качественно","notes":"Bilateral hyperintensity на DWI — severe HIE (cortical-deep gray matter pattern)"},{"name_ru":"Watershed zones T2","name_en":"Watershed zones","term":"No abnormality normally","preterm":"Same","unit":"качественно","notes":"Watershed pattern на DWI — partial prolonged HIE"},{"name_ru":"Corpus callosum thickness (genu)","name_en":"Corpus callosum (genu)","term":"2-3 мм","preterm":"1.5-2.5 мм","unit":"мм","notes":"Hypoplasia / agenesis — chromosomal anomaly, midline malformation"}]}]}