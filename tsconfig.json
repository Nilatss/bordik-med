{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    // P1-CQ-1: every array/dict index access is treated as possibly
    // undefined. Promoted from tsconfig.strict.json after 270 errors
    // were eliminated module-by-module.
    "noUncheckedIndexedAccess": true,
    // P1-CQ-1 sub-task: distinguish between "missing prop" and "prop
    // explicitly set to undefined". Promoted from tsconfig.eopt.json
    // after 58 errors were eliminated (mostly conditional-spread fixes).
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
